{
  "name": "meu-laranjinha",
  "version": "0.1.0",
  "description": "Assistente financeiro via WhatsApp com IA para organizar despesas, receitas e resumos financeiros.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:supabase": "tsx src/scripts/check-supabase.ts",
    "check:repositories": "tsx src/scripts/check-repositories.ts",
    "check:openai": "tsx src/scripts/check-openai.ts",
    "check:zapi": "tsx src/scripts/check-zapi.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "finance",
    "openai",
    "supabase",
    "saas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "openai": "^6.37.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
